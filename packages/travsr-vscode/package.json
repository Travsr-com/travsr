{
  "name": "travsr-vscode",
  "displayName": "Travsr",
  "description": "Graph-native code intelligence for VS Code. Live call graph, blast radius, and callers, powered by the local Travsr daemon over MCP.",
  "version": "0.11.0",
  "publisher": "travsr",
  "license": "Apache-2.0",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1A1A1A",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Travsr-com/travsr"
  },
  "homepage": "https://travsr.com",
  "bugs": {
    "url": "https://github.com/Travsr-com/travsr/issues"
  },
  "qna": "https://github.com/Travsr-com/travsr/discussions",
  "pricing": "Free",
  "keywords": [
    "mcp",
    "code-intelligence",
    "graph",
    "ai",
    "claude",
    "copilot",
    "blast-radius",
    "call-graph"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "AI",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "travsrGraph",
          "title": "Travsr",
          "icon": "resources/icon-activity-bar.svg"
        }
      ]
    },
    "views": {
      "travsrGraph": [
        {
          "id": "travsrGraph",
          "name": "Travsr Graph",
          "when": "true"
        },
        {
          "id": "travsrRepoFiles",
          "name": "Repo Files",
          "when": "true"
        }
      ]
    },
    "commands": [
      {
        "command": "travsr.selectRepository",
        "title": "Travsr: Select Repository"
      },
      {
        "command": "travsr.showStatus",
        "title": "Travsr: Show Status"
      },
      {
        "command": "travsr.showBlastRadius",
        "title": "Travsr: Show Blast Radius"
      },
      {
        "command": "travsr.showCallers",
        "title": "Travsr: Show Callers"
      },
      {
        "command": "travsr.showWelcome",
        "title": "Travsr: Show Welcome"
      },
      {
        "command": "travsr.refreshGraph",
        "title": "Travsr: Refresh Graph",
        "icon": "$(refresh)"
      },
      {
        "command": "travsr.downloadBinary",
        "title": "Travsr: Download Binary"
      },
      {
        "command": "travsr.showGraph",
        "title": "Travsr: Show Graph",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "travsr.askSymbol",
        "title": "Travsr: Ask Symbol",
        "icon": "$(search)"
      },
      {
        "command": "travsr.manageSynonyms",
        "title": "Travsr: Manage Synonyms",
        "icon": "$(symbol-keyword)"
      },
      {
        "command": "travsr.showDependencies",
        "title": "Travsr: Show Dependencies"
      },
      {
        "command": "travsr.showExecutionPath",
        "title": "Travsr: Show Execution Path"
      },
      {
        "command": "travsr.showGraphStats",
        "title": "Travsr: Health",
        "icon": "$(graph)"
      },
      {
        "command": "travsr.showRepos",
        "title": "Travsr: Registered Repos",
        "icon": "$(repo)"
      },
      {
        "command": "travsr.reindexNow",
        "title": "Travsr: Re-index Now",
        "icon": "$(sync)"
      },
      {
        "command": "travsr.openFileGraph",
        "title": "Travsr: Open File Graph",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "travsr.refreshRepoFiles",
        "title": "Travsr: Refresh Repo Files",
        "icon": "$(refresh)"
      },
      {
        "command": "travsr.searchRepoFile",
        "title": "Travsr: Search Files",
        "icon": "$(search)"
      },
      {
        "command": "travsr.openContextExplorer",
        "title": "Travsr: Open Context Explorer",
        "icon": "$(symbol-keyword)"
      },
      {
        "command": "travsr.registerMcpServer",
        "title": "Travsr: Register MCP Server in Agent"
      },
      {
        "command": "travsr.blastBeforeEdit",
        "title": "Travsr: Check Blast Radius Before Edit"
      },
      {
        "command": "travsr.copyContextForChat",
        "title": "Travsr: Copy Graph Context for Chat"
      }
    ],
    "keybindings": [
      {
        "command": "travsr.showGraph",
        "key": "ctrl+shift+g",
        "mac": "cmd+shift+g",
        "when": "editorFocus"
      },
      {
        "command": "travsr.askSymbol",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a",
        "when": "editorFocus"
      },
      {
        "command": "travsr.openContextExplorer",
        "key": "ctrl+shift+k",
        "mac": "cmd+shift+k",
        "when": "editorFocus"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "travsr.searchRepoFile",
          "when": "view == travsrRepoFiles",
          "group": "navigation"
        },
        {
          "command": "travsr.refreshRepoFiles",
          "when": "view == travsrRepoFiles",
          "group": "navigation"
        },
        {
          "command": "travsr.refreshGraph",
          "when": "view == travsrGraph",
          "group": "navigation"
        },
        {
          "command": "travsr.showGraph",
          "when": "view == travsrGraph",
          "group": "navigation"
        },
        {
          "command": "travsr.askSymbol",
          "when": "view == travsrGraph",
          "group": "navigation"
        },
        {
          "command": "travsr.askSymbol",
          "when": "view == travsrGraph",
          "group": "1_travsr@0"
        },
        {
          "command": "travsr.manageSynonyms",
          "when": "view == travsrGraph",
          "group": "1_travsr@1"
        },
        {
          "command": "travsr.showGraphStats",
          "when": "view == travsrGraph",
          "group": "1_travsr@2"
        },
        {
          "command": "travsr.showDependencies",
          "when": "view == travsrGraph",
          "group": "1_travsr@3"
        },
        {
          "command": "travsr.showExecutionPath",
          "when": "view == travsrGraph",
          "group": "1_travsr@4"
        },
        {
          "command": "travsr.showRepos",
          "when": "view == travsrGraph",
          "group": "2_travsr@1"
        },
        {
          "command": "travsr.reindexNow",
          "when": "view == travsrGraph",
          "group": "2_travsr@2"
        },
        {
          "command": "travsr.openContextExplorer",
          "when": "view == travsrGraph",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "travsr.blastBeforeEdit",
          "when": "editorFocus",
          "group": "travsr@1"
        },
        {
          "command": "travsr.openContextExplorer",
          "when": "editorFocus",
          "group": "travsr@2"
        },
        {
          "command": "travsr.copyContextForChat",
          "when": "editorFocus",
          "group": "travsr@3"
        }
      ]
    },
    "colors": [
      {
        "id": "travsr.freshForeground",
        "description": "Color for Travsr status bar when graph is fresh.",
        "defaults": {
          "dark": "#7cf2c5",
          "light": "#0e7a5a",
          "highContrast": "#7cf2c5"
        }
      },
      {
        "id": "travsr.staleForeground",
        "description": "Color for Travsr status bar when graph is stale.",
        "defaults": {
          "dark": "#f59e0b",
          "light": "#b45309",
          "highContrast": "#f59e0b"
        }
      },
      {
        "id": "travsr.errorForeground",
        "description": "Color for Travsr status bar when daemon is disconnected.",
        "defaults": {
          "dark": "#ef4444",
          "light": "#b91c1c",
          "highContrast": "#ef4444"
        }
      }
    ],
    "configuration": {
      "title": "Travsr",
      "properties": {
        "travsr.binaryPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the travsr binary. Leave empty to auto-detect from PATH or use the built-in installer."
        },
        "travsr.statusBarPosition": {
          "type": "string",
          "enum": ["left", "right"],
          "default": "left",
          "description": "Which side of the VS Code status bar the Travsr indicator appears on."
        },
        "travsr.cloudEndpoint": {
          "type": "string",
          "default": "",
          "format": "uri",
          "pattern": "^(https?://.*)?$",
          "patternErrorMessage": "Must be an http:// or https:// URL, or leave empty for local daemon.",
          "description": "Remote SSE endpoint URL. Leave empty to use local daemon over stdio."
        },
        "travsr.telemetry.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Send anonymous usage events to Travsr (extension activated, MCP tool invoked, daemon connection failures). No file paths, symbol names, or graph data are ever sent.",
          "markdownDescription": "Send anonymous usage events to Travsr.\n\n**What is sent:** extension activation, MCP tool names, daemon connection failures.\n\n**What is never sent:** file paths, symbol names, code content, or graph data.\n\nDefault: `false` (opt-in)."
        },
        "travsr.contextTokenBudget": {
          "type": "number",
          "default": 2000,
          "minimum": 500,
          "maximum": 8000,
          "description": "Token budget for \"Copy Graph Context for Chat\" pulls. At 2000 tokens, a typical context is 8 to 15 graph nodes."
        },
        "travsr.suggestSynonyms": {
          "type": "boolean",
          "default": true,
          "description": "When you select a symbol in Ask Symbol whose name differs from your typed query, offer to teach Travsr the synonym so future searches find it faster."
        },
        "travsr.blastRiskThreshold": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "description": "Dependent-file count at which the blast-radius code lens escalates to a high-risk warning. When a file has this many or more dependents, the lens reads \"⚠️ high blast: N files; review before editing\" so you see risk before touching a high-impact file."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "tsc --noEmit -p ./",
    "test": "node ./out/test/runTests.js"
  },
  "overrides": {
    "serialize-javascript": ">=7.0.5"
  },
  "dependencies": {
    "@vscode/extension-telemetry": "^0.9.8"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^26.2.0",
    "@types/vscode": "^1.134.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.1",
    "mocha": "^10.3.0",
    "ovsx": "0.9.5",
    "typescript": "^6.0.3"
  }
}
